{
  "name": "brebble",
  "author": "Matthias Gellrich",
  "version": "2.1.0",
  "keywords": ["pebble-app"],
  "private": true,
  "scripts": {
    "test": "npm run test:js && npm run test:c",
    "test:js": "node --test tests/js/*.test.js",
    "test:c": "mkdir -p build/tests && cc -std=c99 -Wall -Wextra -Werror -Itests/c/stub -o build/tests/test_strings tests/c/test_strings.c src/c/strings.c && build/tests/test_strings"
  },
  "dependencies": {},
  "pebble": {
    "displayName": "Brebble!",
    "uuid": "5a197acd-4c8b-4188-a39b-3bea717f1d64",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "action",
      "itemIndex",
      "itemName",
      "itemDone",
      "itemIcon",
      "errorMsg",
      "errorCode",
      "locale",
      "touchDisabled"
    ],
    "resources": {
      "media": [
        { "type": "bitmap", "name": "ICON_APP", "file": "images/icon_app.png", "menuIcon": true },
        { "type": "bitmap", "name": "ICON_DEFAULT", "file": "images/icon_default.png" },
        { "type": "bitmap", "name": "ICON_PRODUCE", "file": "images/icon_produce.png" },
        { "type": "bitmap", "name": "ICON_BREAD", "file": "images/icon_bread.png" },
        { "type": "bitmap", "name": "ICON_DAIRY", "file": "images/icon_dairy.png" },
        { "type": "bitmap", "name": "ICON_MEAT", "file": "images/icon_meat.png" },
        { "type": "bitmap", "name": "ICON_INGREDIENTS", "file": "images/icon_ingredients.png" },
        { "type": "bitmap", "name": "ICON_FROZEN", "file": "images/icon_frozen.png" },
        { "type": "bitmap", "name": "ICON_GRAIN", "file": "images/icon_grain.png" },
        { "type": "bitmap", "name": "ICON_SNACKS", "file": "images/icon_snacks.png" },
        { "type": "bitmap", "name": "ICON_DRINK", "file": "images/icon_drink.png" },
        { "type": "bitmap", "name": "ICON_HOUSEHOLD", "file": "images/icon_household.png" },
        { "type": "bitmap", "name": "ICON_CARE", "file": "images/icon_care.png" },
        { "type": "bitmap", "name": "ICON_PET", "file": "images/icon_pet.png" },
        { "type": "bitmap", "name": "ICON_GARDEN", "file": "images/icon_garden.png" }
      ]
    }
  }
}
